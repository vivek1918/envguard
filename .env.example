# Copy to .env for local Docker Compose. Never commit real secrets.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=envguard
MYSQL_USER=envguard
MYSQL_PASSWORD=change-me-db

# Backend
ENVGUARD_JWT_SECRET=replace-with-long-random-string-at-least-32-chars
ENVGUARD_PIPELINE_TOKEN=replace-with-long-random-pipeline-token
ENVGUARD_CORS_ORIGINS=http://localhost:4200,http://localhost

# Optional first-admin bootstrap (only when no admin exists)
# ENVGUARD_BOOTSTRAP_ADMIN_USER=admin
# ENVGUARD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
# ENVGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# AWS (prefer IAM role / OIDC over long-lived keys)
AWS_REGION=us-east-1
ENVGUARD_AWS_ENABLED=false
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in git.
# For local testing only, export them in your shell or use `aws login` / SSO.

# Frontend build-time API base (browser-facing)
ENVGUARD_API_PUBLIC_URL=http://localhost:8080/api
