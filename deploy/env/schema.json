{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envguard.local/schemas/env-config.json",
  "title": "EnvGuardEnvironmentConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "variables", "secretReferences"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "secretReferences": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9/_+=.@-]+$"
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  }
}
